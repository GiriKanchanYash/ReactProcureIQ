# Fabric SQL / Warehouse or Lakehouse SQL analytics endpoint
FABRIC_SQL_SERVER=<your-fabric-sql-endpoint>
FABRIC_DATABASE=<your-database>
FABRIC_SCHEMA=Information_mart

# Preferred Azure authentication: Managed Identity / DefaultAzureCredential.
# For local service-principal development, set these three values.
AZURE_TENANT_ID=<tenant-id>
AZURE_CLIENT_ID=<client-id>
AZURE_CLIENT_SECRET=<client-secret>

# Azure OpenAI / Microsoft Foundry
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT=<deployment-name>
# Optional for local-only testing; Entra ID is preferred in Azure.
# AZURE_OPENAI_API_KEY=<key>

# App
P2P_AUTH_SECRET=<long-random-secret>
DEMO_AUTH_ENABLED=true
ALLOWED_ORIGINS=http://localhost:5175,http://localhost:5173
P2P_CACHE_TTL_SECONDS=300

# Keep true for the unchanged reference React login. Set false only after
# replacing the login UI with an Entra-integrated sign-in flow.

# Optional policy knowledge base (same logical role as Snowflake POLICY_KB).
# FABRIC_POLICY_TABLE=POLICY_KB

# Optional direct OneLake Delta writes for app-state tables.
ONELAKE_SAVED_INSIGHTS_PATH=
ONELAKE_GENIE_QUESTION_HISTORY_PATH=
ONELAKE_AGENT_REVIEW_LOG_PATH=
